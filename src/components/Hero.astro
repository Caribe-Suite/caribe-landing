---
import { Smartphone, Layout as LayoutIcon, Zap, ChevronLeft, ChevronRight } from "@lucide/astro";
import logo from "../assets/logo.png";
import slide1 from "../assets/slide-1.png";
import slide2 from "../assets/slide-2.png";
import slide3 from "../assets/slide-3.png";
import mockupMobile from "../assets/mockup-mobile.png";

const slides = [
  { src: slide1.src, alt: "Caribe Suite Dashboard - Módulo Principal" },
  { src: slide2.src, alt: "Caribe Suite Dashboard - Vista de Inventario" },
  { src: slide3.src, alt: "Caribe Suite Dashboard - Punto de Venta" },
];
---

<header
  class="bg-white border-b border-slate-100 pt-16 pb-0 md:pt-24 px-4 overflow-hidden relative"
>
  <!-- Abstract background elements -->
  <div
    class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 bg-slate-50 rounded-full blur-3xl opacity-50"
  >
  </div>
  <div
    class="absolute bottom-0 left-0 -ml-20 -mb-20 w-80 h-80 bg-slate-50 rounded-full blur-3xl opacity-50"
  >
  </div>

  <div class="max-w-6xl mx-auto relative">
    <div class="text-center mb-12">
      <div class="flex justify-center mb-6">
        <img
          src={logo.src}
          alt="Caribe Suite Logo"
          class="h-32 md:h-48 w-auto"
        />
      </div>

      <h1
        class="text-slate-900 text-3xl md:text-6xl font-extrabold mb-6 tracking-tight"
      >
        Caribe Suite
      </h1>
      <p
        class="text-lg md:text-2xl text-slate-700 font-medium mb-6 max-w-3xl mx-auto leading-tight max-sm:text-left"
      >
        La plataforma integral para gestionar tu negocio con facilidad y
        eficiencia.
      </p>
      <p
        class="text-base md:text-lg text-slate-500 mb-10 max-w-3xl mx-auto leading-relaxed max-sm:text-left"
      >
        Caribe Suite es un sistema de gestión empresarial diseñado para
        simplificar la administración de tu empresa. Con una interfaz moderna y
        accesible desde cualquier dispositivo, combina contabilidad, inventario,
        punto de venta y control administrativo en una sola solución.
      </p>

      <div class="flex flex-wrap justify-center gap-4 mb-16">
        <a
          href="#features"
          class="bg-slate-900 text-white px-8 py-4 rounded-xl font-bold text-lg hover:bg-slate-800 transition-all shadow-lg active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
        >
          Ver módulos
        </a>
        <a
          href="#about"
          class="bg-white text-slate-700 border border-slate-200 px-8 py-4 rounded-xl font-bold text-lg hover:bg-slate-50 transition-all active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2"
        >
          Beneficios
        </a>
      </div>
    </div>

    <!-- App Mockup Display Carousel -->
    <div class="relative max-w-5xl mx-auto px-4 sm:px-0 group/carousel">
      <div
        class="bg-slate-200 rounded-t-xl md:rounded-t-3xl p-1 md:p-2 pb-0 shadow-2xl border border-slate-300 border-b-0 relative"
      >
        <div
          id="hero-carousel-track"
          class="flex overflow-x-auto snap-x snap-mandatory scroll-smooth rounded-t-xl md:rounded-t-2xl scrollbar-none"
        >
          {
            slides.map((slide, i) => (
              <div class="flex-none w-full snap-start hero-slide" data-index={i}>
                <img
                  src={slide.src}
                  alt={slide.alt}
                  class="rounded-t-xl md:rounded-t-2xl w-full h-auto block shadow-inner"
                />
              </div>
            ))
          }
        </div>

        <!-- Carousel navigation arrows -->
        <button
          type="button"
          id="hero-btn-prev"
          class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 md:w-11 md:h-11 rounded-full bg-white/90 hover:bg-white text-slate-800 border border-slate-200/80 shadow-lg flex items-center justify-center transition-all opacity-0 group-hover/carousel:opacity-100 focus-visible:opacity-100 disabled:opacity-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 z-20"
          aria-label="Captura anterior"
        >
          <ChevronLeft size={22} />
        </button>
        <button
          type="button"
          id="hero-btn-next"
          class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 md:w-11 md:h-11 rounded-full bg-white/90 hover:bg-white text-slate-800 border border-slate-200/80 shadow-lg flex items-center justify-center transition-all opacity-0 group-hover/carousel:opacity-100 focus-visible:opacity-100 disabled:opacity-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 focus-visible:ring-offset-2 z-20"
          aria-label="Captura siguiente"
        >
          <ChevronRight size={22} />
        </button>
      </div>

      <!-- Carousel indicators -->
      <div class="flex justify-center items-center gap-1 mt-4" id="hero-dots">
        {
          slides.map((_, i) => (
            <button
              type="button"
              class="hero-dot-btn group/dot p-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-900 rounded-full"
              data-dot={i}
              aria-label={`Ir a la captura ${i + 1}`}
            >
              <span class="hero-dot-inner block w-2 h-2 rounded-full bg-slate-300 transition-all duration-300 group-hover/dot:bg-slate-400" />
            </button>
          ))
        }
      </div>

      <!-- Mobile Mockup Floating -->
      <div
        class="absolute -bottom-10 -right-2 sm:-bottom-20 sm:-right-8 md:-right-16 lg:-right-36 w-[140px] sm:w-[200px] md:w-[260px] lg:w-[320px] z-40 drop-shadow-2xl pointer-events-none"
      >
        <img
          src={mockupMobile.src}
          alt="Caribe Suite Mobile"
          class="w-full h-auto drop-shadow-2xl"
        />
      </div>
    </div>
  </div>
</header>

<div class="bg-slate-50 border-b border-slate-100 py-8">
  <div class="max-w-6xl mx-auto px-4">
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-8 text-slate-500 max-sm:max-w-xs max-sm:mx-auto"
    >
      <div class="flex items-center gap-4 justify-start md:justify-start">
        <div
          class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm shrink-0"
        >
          <LayoutIcon size={24} class="text-slate-800" />
        </div>
        <div>
          <p class="font-bold text-slate-900">Interfaz Moderna</p>
          <p class="text-sm">Diseñada para la eficiencia</p>
        </div>
      </div>
      <div class="flex items-center gap-4 justify-start md:justify-center">
        <div
          class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm shrink-0"
        >
          <Smartphone size={24} class="text-slate-800" />
        </div>
        <div>
          <p class="font-bold text-slate-900">Multi-dispositivo</p>
          <p class="text-sm">Accede desde cualquier lugar</p>
        </div>
      </div>
      <div class="flex items-center gap-4 justify-start md:justify-end">
        <div
          class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm shrink-0"
        >
          <Zap size={24} class="text-slate-800" />
        </div>
        <div>
          <p class="font-bold text-slate-900">Rendimiento Fluido</p>
          <p class="text-sm">Tecnología web de vanguardia</p>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  @reference "../styles/global.css";

  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .hero-dot-btn.active .hero-dot-inner {
    @apply bg-slate-900 w-5;
  }
</style>

<script>
  const track = document.getElementById("hero-carousel-track") as HTMLElement;
  const btnPrev = document.getElementById("hero-btn-prev") as HTMLButtonElement;
  const btnNext = document.getElementById("hero-btn-next") as HTMLButtonElement;
  const dotBtns = document.querySelectorAll<HTMLButtonElement>(".hero-dot-btn");

  let currentIndex = 0;
  let isProgrammaticScroll = false;

  function getSlideWidth(): number {
    const slide = track?.querySelector<HTMLElement>(".hero-slide");
    return slide ? slide.offsetWidth : track.offsetWidth;
  }

  function scrollToIndex(index: number) {
    if (!track) return;
    currentIndex = Math.max(0, Math.min(index, dotBtns.length - 1));
    isProgrammaticScroll = true;
    track.scrollTo({ left: currentIndex * getSlideWidth(), behavior: "smooth" });
    updateState();

    setTimeout(() => {
      isProgrammaticScroll = false;
    }, 800);
  }

  function updateState() {
    dotBtns.forEach((btn, i) => {
      const isActive = i === currentIndex;
      btn.classList.toggle("active", isActive);
      if (isActive) {
        btn.setAttribute("aria-current", "true");
      } else {
        btn.removeAttribute("aria-current");
      }
    });

    if (btnPrev) btnPrev.disabled = currentIndex === 0;
    if (btnNext) btnNext.disabled = currentIndex === dotBtns.length - 1;
  }

  btnPrev?.addEventListener("click", () => scrollToIndex(currentIndex - 1));
  btnNext?.addEventListener("click", () => scrollToIndex(currentIndex + 1));

  dotBtns.forEach((btn, i) => {
    btn.addEventListener("click", () => scrollToIndex(i));
  });

  let scrollTimer: ReturnType<typeof setTimeout>;
  track?.addEventListener("scroll", () => {
    if (isProgrammaticScroll) return;
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(() => {
      const slideWidth = getSlideWidth();
      if (slideWidth > 0) {
        currentIndex = Math.round(track.scrollLeft / slideWidth);
        updateState();
      }
    }, 80);
  });

  updateState();
</script>
